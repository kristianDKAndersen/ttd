{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TTD",
  "mainBinaryName": "ttd",
  "version": "0.1.0",
  "identifier": "io.github.kristiandkandersen.ttd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd .. && bun run dev:ui",
    "beforeBuildCommand": "cd .. && bun run build:ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TTD",
        "width": 320,
        "height": 480,
        "minWidth": 260,
        "minHeight": 200,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Always-on-top todo list shared with Claude Code",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
